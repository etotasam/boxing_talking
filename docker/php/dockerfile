# 検証したPHPのパッチ版・OS・取得元を固定する。
FROM php:8.4.27-fpm-trixie@sha256:070c5a1dac19c108905c09093e3f5cf228ece8feaea84e33135b3da99de32946


RUN apt-get update \
    && apt-get install -y \
    git \
    zip \
    unzip \
    vim \
    default-mysql-client

# install composer
COPY --from=composer:2.9.4@sha256:22a95bd2bc3cf6ff19550a246208138d35f0015602db3d67dc6841945324acc1 /usr/bin/composer /usr/bin/composer

RUN docker-php-ext-install pdo_mysql

# node.js install
RUN apt-get install -y nodejs npm && npm install n -g && n 16.13.2


WORKDIR /var/www/html