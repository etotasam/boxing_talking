# 検証したPHPのパッチ版・OS・取得元を固定する。
FROM php:8.5.13-fpm-trixie@sha256:7fd2766bd3bb6efcfb49591e4bf014e123c18f01149093bd508525c6bdf0cf9f


RUN apt-get update \
    && apt-get install -y \
    git \
    zip \
    unzip \
    vim \
    default-mysql-client

# install composer
COPY --from=composer:2.9.4@sha256:22a95bd2bc3cf6ff19550a246208138d35f0015602db3d67dc6841945324acc1 /usr/bin/composer /usr/bin/composer

RUN docker-php-ext-install pdo_mysql



WORKDIR /var/www/html
